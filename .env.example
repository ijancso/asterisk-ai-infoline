# ─────────────────────────────────────────
# OpenAI
# ─────────────────────────────────────────
OPENAI_API_KEY=sk-...

# Whisper model: whisper-1
WHISPER_MODEL=whisper-1

# GPT model for responses
GPT_MODEL=gpt-4o

# TTS voice: alloy | echo | fable | onyx | nova | shimmer
TTS_VOICE=nova

# ─────────────────────────────────────────
# SIP / Twilio
# ─────────────────────────────────────────
# Twilio SIP trunk hostname (find in Twilio Console > Voice > SIP Trunking)
# Development (HU):   your-trunk.pstn.twilio.com
# Production (NZ):    your-trunk.pstn.twilio.com  (same, but NZ number attached)
SIP_TRUNK_HOST=your-trunk.pstn.twilio.com

SIP_USERNAME=your_sip_username
SIP_PASSWORD=your_sip_password

# Your server's public IP (Asterisk uses this for SIP registration)
SERVER_PUBLIC_IP=1.2.3.4

# ─────────────────────────────────────────
# AI Persona
# ─────────────────────────────────────────
AI_PERSONA=You are a friendly and professional information line assistant. Answer questions clearly and concisely. If you don't know the answer to something, say so honestly and suggest the caller try another resource. Keep responses under 3 sentences — this is a phone call, not a chat. Speak naturally.

# ─────────────────────────────────────────
# Call settings
# ─────────────────────────────────────────
# Maximum call duration in seconds (default 5 minutes)
MAX_CALL_DURATION=300

# Silence timeout: hang up after N seconds of silence at start
SILENCE_TIMEOUT=10

# ─────────────────────────────────────────
# Logging
# ─────────────────────────────────────────
LOG_LEVEL=INFO
